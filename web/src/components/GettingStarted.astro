---
const steps = [
  {
    num: "01",
    title: "Install call-use",
    code: `<span class="code-text-muted">$</span> <span class="code-function">pip</span> install call-use`,
  },
  {
    num: "02",
    title: "Configure credentials",
    code: `<span class="code-comment"># .env</span>
<span class="code-property">LIVEKIT_URL</span><span class="code-operator">=</span><span class="code-string">wss://your-project.livekit.cloud</span>
<span class="code-property">LIVEKIT_API_KEY</span><span class="code-operator">=</span><span class="code-string">your_api_key</span>
<span class="code-property">LIVEKIT_API_SECRET</span><span class="code-operator">=</span><span class="code-string">your_api_secret</span>
<span class="code-property">TWILIO_ACCOUNT_SID</span><span class="code-operator">=</span><span class="code-string">your_sid</span>
<span class="code-property">TWILIO_AUTH_TOKEN</span><span class="code-operator">=</span><span class="code-string">your_token</span>`,
  },
  {
    num: "03",
    title: "Start the worker",
    code: `<span class="code-text-muted">$</span> <span class="code-function">call-use</span> worker start`,
  },
  {
    num: "04",
    title: "Make a call",
    code: `<span class="code-keyword">from</span> <span class="code-variable">call_use</span> <span class="code-keyword">import</span> <span class="code-function">CallAgent</span>

<span class="code-variable">outcome</span> <span class="code-operator">=</span> <span class="code-keyword">await</span> <span class="code-function">CallAgent</span><span class="code-operator">(</span>
    <span class="code-property">phone</span><span class="code-operator">=</span><span class="code-string">"+18001234567"</span><span class="code-operator">,</span>
    <span class="code-property">instructions</span><span class="code-operator">=</span><span class="code-string">"Cancel my subscription"</span>
<span class="code-operator">).</span><span class="code-function">call</span><span class="code-operator">()</span>`,
  },
];
---

<section id="getting-started" class="relative py-24 sm:py-32 bg-bg-secondary/30">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-16 max-w-2xl text-center">
      <h2 class="mb-4 text-3xl font-bold tracking-tight sm:text-4xl">
        Get started in <span class="gradient-text">4 steps</span>
      </h2>
      <p class="text-lg text-text-secondary">
        From zero to your first AI phone call in under 5 minutes.
      </p>
    </div>

    <div class="mx-auto max-w-3xl space-y-6">
      {steps.map((step) => (
        <div class="overflow-hidden rounded-xl border border-border-subtle transition-all hover:border-accent/20">
          <div class="flex items-center gap-4 border-b border-border-subtle bg-bg-secondary/80 px-5 py-3.5">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent/20 text-xs font-bold text-accent-light">{step.num}</span>
            <span class="text-sm font-semibold text-text-primary">{step.title}</span>
          </div>
          <pre class="overflow-x-auto bg-bg-secondary/40 p-5 font-mono text-sm leading-relaxed"><code><Fragment set:html={step.code} /></code></pre>
        </div>
      ))}
    </div>
  </div>
</section>
