---
const features = [
  {
    title: "3 Lines of Code",
    description: "Make a phone call with just 3 lines of Python. No boilerplate, no complex setup.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>`,
  },
  {
    title: "IVR Navigation",
    description: "Navigate phone menus, press DTMF buttons, and handle hold music automatically.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>`,
  },
  {
    title: "Human Takeover",
    description: "Pause the agent, join the call yourself, then hand control back when ready.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>`,
  },
  {
    title: "Approval Flow",
    description: "Agent asks for permission before taking sensitive actions. You stay in control.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>`,
  },
  {
    title: "Works Everywhere",
    description: "Python SDK, CLI, MCP Server, REST API -- pick the interface that fits your stack.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>`,
  },
  {
    title: "Open Source",
    description: "MIT licensed, fully self-hostable, no vendor lock-in. Own your infrastructure.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>`,
  },
];
---

<section id="features" class="relative py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="mx-auto mb-16 max-w-2xl text-center">
      <h2 class="mb-4 text-3xl font-bold tracking-tight sm:text-4xl">
        Everything you need for <span class="gradient-text">AI phone calls</span>
      </h2>
      <p class="text-lg text-text-secondary">
        A complete runtime for outbound call control -- from simple calls to complex multi-step workflows.
      </p>
    </div>

    <!-- Feature grid -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((feature) => (
        <div class="group rounded-xl border border-border-subtle bg-bg-secondary/50 p-6 transition-all hover:border-accent/30 hover:bg-bg-secondary">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-lg bg-accent/10">
            <svg class="h-5 w-5 text-accent-light" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <Fragment set:html={feature.icon} />
            </svg>
          </div>
          <h3 class="mb-2 text-lg font-semibold text-text-primary">{feature.title}</h3>
          <p class="text-sm leading-relaxed text-text-secondary">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
